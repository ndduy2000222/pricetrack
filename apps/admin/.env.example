# Server-only. Never prefix these with NEXT_PUBLIC_ or commit real values.
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_ACCESS_TOKEN_EXPIRES_AT=
SHOPEE_SHOP_ID=

# Comma-separated item_id:model_id pairs, for example: 123456789:987654321,123456789:987654322
SHOPEE_TRACKED_SKUS=

# Server-only token rotation storage. Use a 32-byte hex or base64 key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Current Supabase projects may call the server-only key SUPABASE_SECRET_KEY.
SUPABASE_SECRET_KEY=
SHOPEE_TOKEN_ENCRYPTION_KEY=

# Optional protection for full catalog/review sync endpoints.
CATALOG_SYNC_SECRET=

# Required for the explicit, manual DiscountManager write endpoint.
SHOPEE_DISCOUNT_WRITE_SECRET=

# Multi-shop portal. Use a separate long random value for production admin unlock.
SHOP_PORTAL_ADMIN_SECRET=
SHOP_PORTAL_ALLOWED_EMAILS=
SHOPEE_REDIRECT_URI=https://your-domain.example/api/shopee/callback

# Competitor feeds must be explicitly permitted/contracted sources. The app only
# consumes normalized JSON and does not bypass CAPTCHA or access controls.
SHOPEE_COMPETITOR_FEED_URL=
SHOPEE_COMPETITOR_FEED_NAME=
SHOPEE_COMPETITOR_FEED_URL_1=
SHOPEE_COMPETITOR_FEED_NAME_1=
SHOPEE_COMPETITOR_FEED_URL_2=
SHOPEE_COMPETITOR_FEED_NAME_2=
SHOPEE_COMPETITOR_FEED_URL_3=
SHOPEE_COMPETITOR_FEED_NAME_3=
SHOPEE_COMPETITOR_FEED_URL_4=
SHOPEE_COMPETITOR_FEED_NAME_4=
SHOPEE_COMPETITOR_FEED_URL_5=
SHOPEE_COMPETITOR_FEED_NAME_5=
# Optional Bearer token for a private normalized feed. It is sent only as an
# Authorization header and never put into a URL or UI.
SHOPEE_COMPETITOR_FEED_TOKEN=
SHOPEE_COMPETITOR_FEED_TOKEN_1=
SHOPEE_COMPETITOR_FEED_TOKEN_2=
SHOPEE_COMPETITOR_FEED_TOKEN_3=
SHOPEE_COMPETITOR_FEED_TOKEN_4=
SHOPEE_COMPETITOR_FEED_TOKEN_5=
SHOPEE_COMPETITOR_SOURCE_APPROVED=false

# Optional official Shopee Affiliate discovery by product name. This is a
# candidate finder only: productOfferV2 does not provide model/ISBN-level
# evidence, so candidates are visible in the 5-shop panel but cannot drive a
# price proposal until an approved exact-listing feed confirms them.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_COMPETITOR_DISCOVERY_LIMIT=10
COMPETITOR_SYNC_SECRET=
SHOPEE_COMPETITOR_SHOP_NAME_1=Omega Plus Books Store
SHOPEE_COMPETITOR_SHOP_NAME_2=Trạm Đọc HCM
SHOPEE_COMPETITOR_SHOP_NAME_3=Nhà Sách Trạm Đọc
SHOPEE_COMPETITOR_SHOP_NAME_4=Trạm Đọc Books
SHOPEE_COMPETITOR_SHOP_NAME_5=Read Station

# Business inputs. Leave unset to keep proposals in simulation/blocked state.
PRICE_COSTS_JSON={}
PRICE_PLATFORM_FEE_PERCENT=
PRICE_OPERATION_COST_VND=
PRICE_MIN_MARGIN_VND=
PRICE_BUFFER_AMOUNT_VND=
PRICE_BUFFER_PERCENT=
PRICE_COMPETITOR_MAX_AGE_MINUTES=60
