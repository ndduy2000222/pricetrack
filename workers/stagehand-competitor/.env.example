# Local worker only. Do not copy these secrets into Vercel or commit a real .env file.
STAGEHAND_PORT=8787
STAGEHAND_WORKER_SECRET=
STAGEHAND_CATALOG_URL=https://alpha-books-price-control.vercel.app/api/catalog?source=stored
STAGEHAND_CATALOG_SYNC_SECRET=
STAGEHAND_MODEL=openai/gpt-5.4-mini
OPENAI_API_KEY=
STAGEHAND_BROWSER_PROFILE_DIR=./browser-data
STAGEHAND_DATA_FILE=./data/competitor-offers.json
STAGEHAND_LIMIT=10
STAGEHAND_DELAY_MS=1800
STAGEHAND_RUN_INTERVAL_MINUTES=0
STAGEHAND_RUN_ON_START=false

# Vercel feed integration. Use the same secret in
# SHOPEE_COMPETITOR_FEED_TOKEN_1..5, one token per worker feed.
STAGEHAND_FEED_TOKEN=
